{
    "openapi": "3.0.0",
    "info": {
        "title": "VentasFix API",
        "description": "API REST para gestión de Usuarios, Productos y Clientes de VentasFix",
        "version": "1.0.0"
    },
    "paths": {
        "/api/productos": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Listar todos los productos",
                "operationId": "786d74243fbf30dace82b25a638113b4",
                "responses": {
                    "200": {
                        "description": "Lista de productos obtenida correctamente"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Productos"
                ],
                "summary": "Crear un nuevo producto",
                "operationId": "fc219fac91d809b8de37c41b5bf9f22a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "sku",
                                    "nombre",
                                    "descripcion_corta",
                                    "descripcion_larga",
                                    "imagen",
                                    "precio_neto",
                                    "stock_actual",
                                    "stock_minimo",
                                    "stock_bajo",
                                    "stock_alto"
                                ],
                                "properties": {
                                    "sku": {
                                        "type": "string"
                                    },
                                    "nombre": {
                                        "type": "string"
                                    },
                                    "descripcion_corta": {
                                        "type": "string"
                                    },
                                    "descripcion_larga": {
                                        "type": "string"
                                    },
                                    "imagen": {
                                        "type": "string"
                                    },
                                    "precio_neto": {
                                        "type": "number"
                                    },
                                    "stock_actual": {
                                        "type": "integer"
                                    },
                                    "stock_minimo": {
                                        "type": "integer"
                                    },
                                    "stock_bajo": {
                                        "type": "integer"
                                    },
                                    "stock_alto": {
                                        "type": "integer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Producto creado correctamente"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/productos/{id}": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Obtener un producto por su ID",
                "operationId": "d82fcf54a61b41d79fee46cb397bddab",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Producto encontrado"
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Productos"
                ],
                "summary": "Actualizar un producto por su ID",
                "operationId": "280626c3f6abde471e667928d265047e",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "sku": {
                                        "type": "string"
                                    },
                                    "nombre": {
                                        "type": "string"
                                    },
                                    "descripcion_corta": {
                                        "type": "string"
                                    },
                                    "descripcion_larga": {
                                        "type": "string"
                                    },
                                    "imagen": {
                                        "type": "string"
                                    },
                                    "precio_neto": {
                                        "type": "number"
                                    },
                                    "stock_actual": {
                                        "type": "integer"
                                    },
                                    "stock_minimo": {
                                        "type": "integer"
                                    },
                                    "stock_bajo": {
                                        "type": "integer"
                                    },
                                    "stock_alto": {
                                        "type": "integer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Producto actualizado correctamente"
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Productos"
                ],
                "summary": "Eliminar un producto por su ID",
                "operationId": "17628a29ac5e40fc6022f71f89626e92",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Producto eliminado correctamente"
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Iniciar sesión y obtener un token de acceso",
                "operationId": "42162ecc918d412e9f60eb52e05d8da9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "usuario@ventasfix.cl"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "contraseña123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login exitoso, devuelve el token"
                    },
                    "401": {
                        "description": "Credenciales incorrectas"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "Sanctum Token",
                "description": "Ingresa el token obtenido en /api/login, sin la palabra \"Bearer\" adelante."
            }
        }
    },
    "tags": [
        {
            "name": "Productos",
            "description": "Productos"
        },
        {
            "name": "Autenticación",
            "description": "Autenticación"
        }
    ]
}